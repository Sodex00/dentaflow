{
  "name": "DentaFlow",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "DentaFlow Mini App",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install"
}
